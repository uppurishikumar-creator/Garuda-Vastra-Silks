# Copy this file to .env for your laptop. Never commit .env.
# On Vercel, set these in: Project → Settings → Environment Variables.

# Online database (Neon). Vercel adds this automatically when you connect Neon in the Storage tab.
# Leave EMPTY on your laptop to use the built-in local database in ./data
DATABASE_URL=

# Password for the first "owner" login (used only when the database is brand new). REQUIRED on Vercel.
ADMIN_PASSWORD=

# Long random text (at least 32 characters) for signing logins. Optional — if empty, one is generated and kept in the database.
JWT_SECRET=

# Set to "false" to start with no products instead of the 13 sample sarees
SEED_SAMPLE=true

PORT=3000
