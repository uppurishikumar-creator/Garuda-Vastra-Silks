# Copy this file to .env and fill in. Never commit .env.
PORT=3000
# Long random text (at least 32 characters). If empty, one is generated in data/.jwt-secret
JWT_SECRET=
# Password for the first "owner" login (only used the very first time). If empty, a random one is printed.
ADMIN_PASSWORD=
# Set to "false" to start with an empty product list instead of the 13 sample sarees
SEED_SAMPLE=true
# Set to "production" when running on a real server with HTTPS (makes login cookie HTTPS-only)
NODE_ENV=development
# Optional: where the database is stored (default ./data)
# DATA_DIR=
